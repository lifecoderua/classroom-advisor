# Copy to .env and adjust. Every value is optional; env vars override config.local.json.

# Chrome profile used by the collector (~ is expanded).
# CA_PROFILE_DIR=~/.classroom-advisor/chrome-profile

# Browser for the collector: chrome (installed Google Chrome) | chromium (Playwright's bundled
# build; the Docker image picks it on arm64). Log the profile in with the same browser.
# CA_CHROME_CHANNEL=chrome

# Where captures, files and the DB live. Gitignored.
# CA_DATA_DIR=./.data

# Comma-separated list of accounts to sync.
# CA_WATCHED_ACCOUNTS=student-one@school.example,student-two@school.example

# LLM provider: claude-cli | gemini | fake
# CA_LLM_PROVIDER=claude-cli

# Path or name of the claude CLI binary.
# CA_CLAUDE_BIN=claude

# Model for the claude CLI (alias like sonnet/opus, or a full id). CLI default when unset.
# CA_CLAUDE_MODEL=sonnet

# Timeout for one LLM call, in milliseconds.
# CA_LLM_TIMEOUT_MS=180000

# Gemini provider (CA_LLM_PROVIDER=gemini). The key is a secret: set it here or in the
# environment only, never in config.local.json.
# GEMINI_API_KEY=
# CA_GEMINI_MODEL=gemini-3.8-flash

# Language of everything the parent reads (alerts, digests, report, bot replies, LLM review):
# uk | ru | en. Time zone (IANA) for the digest time, quiet hours and every displayed time.
# CA_DIGEST_LANG=uk
# CA_TIMEZONE=Europe/Kyiv

# `run` loop: minutes between cycles, and quiet hours in CA_TIMEZONE (HH:MM-HH:MM, may cross
# midnight).
# CA_RUN_INTERVAL_MIN=60
# CA_QUIET_HOURS=22:00-07:00

# Sync: deadline reminders (untouched_24h, no_due_date) only for items posted within this
# many days; full detail refresh interval; pause between Classroom RPC calls.
# CA_ALERT_LOOKBACK_DAYS=14
# CA_FULL_REFRESH_DAYS=7
# CA_SYNC_DELAY_MS=300

# Open debts (teacher redo requests, missing work, "check by hand" items) repeat in every digest
# and console report until resolved or acked, and are forgotten this many days after they appeared.
# CA_BACKLOG_FORGET_DAYS=14

# Telegram notifier (optional). The bot token is a secret: here or in the environment only,
# never in config.local.json. Chat ids are written by `pnpm cli telegram link` into
# config.local.json; this env var overrides them. Panics go out right after each cycle, the rest
# in a daily digest at CA_TELEGRAM_DIGEST_TIME (HH:MM in CA_TIMEZONE, outside quiet hours).
# A private group works too (add the bot, send /start@<bot> there, then `telegram link`); when
# Telegram upgrades it to a supergroup, the new chat id is picked up automatically.
# TELEGRAM_BOT_TOKEN=
# CA_TELEGRAM_CHAT_IDS=123456789
# CA_TELEGRAM_DIGEST_TIME=19:00
