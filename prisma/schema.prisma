// SQLite via @prisma/adapter-better-sqlite3. DB path: <dataDir>/app.db (see prisma.config.ts).
// All timestamps are UTC. Evolving value sets (kinds, statuses, verdicts) are plain strings;
// the allowed values are typed in src/store/types.ts. JSON blobs are stored as String.

generator client {
  provider            = "prisma-client"
  output              = "../src/store/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  displayName String?
  watched     Boolean      @default(false)
  /// Last known `/u/N/` index; informational only, accounts are addressed by `authuser=<email>`.
  authuser    String?
  /// End of the first successful sync. Null until then: that sync is the baseline, whose
  /// items are stored without events and kept out of most alerts (see docs/ARCHITECTURE.md).
  baselineAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]
  assignments Assignment[]
  events      Event[]
  syncRuns    SyncRun[]
}

model Course {
  id          Int          @id @default(autoincrement())
  accountId   Int
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Classroom's course id.
  classroomId String
  name        String
  firstSeenAt DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())
  assignments Assignment[]

  @@unique([accountId, classroomId])
}

model Assignment {
  id              Int                 @id @default(autoincrement())
  accountId       Int
  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  courseId        Int
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Classroom's coursework id.
  classroomId     String
  /// assignment | question | material | quiz | unknown
  kind            String
  title           String
  dueAt           DateTime?
  postedAt        DateTime?
  /// assigned | turned_in | missing | returned | ...
  status          String
  currentHash     String
  /// Hash of the To-do summary; a change triggers a detail fetch.
  summaryHash     String?
  detailFetchedAt DateTime?
  /// First stored by the account's baseline sync (it existed before we started watching).
  baseline        Boolean             @default(false)
  firstSeenAt     DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  versions        AssignmentVersion[]
  submission      Submission?
  attachments     Attachment[]
  comments        Comment[]
  events          Event[]

  @@unique([accountId, classroomId])
  @@index([dueAt])
}

/// A private comment on the watched student's submission (`sLc6hf`), between the student and
/// the class's teachers. Deduped by Classroom's comment id; an edit updates `text` in place.
model Comment {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Classroom's comment id.
  classroomId  String
  /// teacher | student | unknown
  authorRole   String
  /// Classroom user id of the author (names are not stored).
  authorId     String?
  /// Plain text of the comment.
  text         String
  /// When the comment was posted (Classroom's `[1]`).
  postedAt     DateTime
  /// Old news when first stored: written by the baseline sync, or on a baseline item and
  /// posted before the account's `baselineAt`. No event or alert.
  baseline     Boolean    @default(false)
  firstSeenAt  DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())

  @@unique([assignmentId, classroomId])
  @@index([assignmentId, postedAt])
}

/// One row per observed content change: history of edits (e.g. a moved deadline).
model AssignmentVersion {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  hash         String
  /// Normalized assignment object as JSON.
  payload      String
  seenAt       DateTime   @default(now())

  @@index([assignmentId, seenAt])
}

/// The watched student's own submission; one per assignment (the account is the student).
model Submission {
  id           Int                 @id @default(autoincrement())
  assignmentId Int                 @unique
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// new | created | turned_in | returned | reclaimed | ...
  state        String
  turnedInAt   DateTime?
  grade        String?
  currentHash  String
  firstSeenAt  DateTime            @default(now())
  lastSeenAt   DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  versions     SubmissionVersion[]
  attachments  Attachment[]
}

model SubmissionVersion {
  id           Int           @id @default(autoincrement())
  submissionId Int
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  hash         String
  state        String
  /// Normalized submission object as JSON.
  payload      String
  /// Written by the baseline sync: never quality-reviewed.
  baseline     Boolean       @default(false)
  seenAt       DateTime      @default(now())
  checkResults CheckResult[]

  @@index([submissionId, seenAt])
}

/// A teacher material (owner = material) or a student file (owner = submission).
/// Always tied to the assignment; `submissionId` is set for submission attachments.
model Attachment {
  id               Int         @id @default(autoincrement())
  assignmentId     Int
  assignment       Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId     Int?
  submission       Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// material | submission
  owner            String
  url              String
  title            String?
  driveFileId      String?
  mime             String?
  modifiedAt       DateTime?
  /// Fetched content cache, relative to dataDir.
  contentPath      String?
  contentHash      String?
  fetchedAt        DateTime?
  /// Last fetch failure (e.g. `file too large (…)`, `HTTP 403`); cleared when content is fetched.
  fetchError       String?
  /// Material is a "make a copy for each student" template (inferred by the detail parser).
  isTemplate       Boolean     @default(false)
  /// Student copy: Drive id of the template it was made from (inferred by the detail parser).
  templateSourceId String?
  firstSeenAt      DateTime    @default(now())
  lastSeenAt       DateTime    @default(now())

  @@unique([assignmentId, owner, url])
  @@index([driveFileId])
}

model CheckResult {
  id                  Int               @id @default(autoincrement())
  submissionVersionId Int
  submissionVersion   SubmissionVersion @relation(fields: [submissionVersionId], references: [id], onDelete: Cascade)
  /// heuristic | llm:<provider>
  source              String
  /// ok | warn | panic | unchecked (nothing could be checked automatically)
  verdict             String
  /// Signals / LLM output as JSON.
  findings            String
  /// LLM results: the highest `Comment.id` of the assignment when the review ran (null: none).
  /// A fresh teacher comment with a higher id re-queues a review of the version (#44).
  throughCommentId    Int?
  createdAt           DateTime          @default(now())

  @@index([submissionVersionId])
}

model Alert {
  id        Int       @id @default(autoincrement())
  /// Dedupe key, e.g. `quality:<submissionVersionId>`.
  key       String    @unique
  /// info | alert | panic
  level     String
  /// What the alert says: a code (`AlertContent` in src/store/types.ts) rendered in the configured
  /// language at print/send time. `text` = free text in `params.text` (untranslated).
  code      String    @default("text")
  /// Params of `code` as JSON.
  params    String    @default("{}")
  createdAt DateTime  @default(now())
  /// Delivered to Telegram (the only push channel; the console never sets it). Also set by
  /// `/ack`, so a muted alert never goes out.
  sentAt    DateTime?
  /// Muted with the Telegram `/ack <id>` command: left out of digests, `/status` and the
  /// default console report.
  mutedAt   DateTime?

  @@index([sentAt])
}

/// Domain event emitted by sync. `key` makes emission idempotent (reruns add nothing).
model Event {
  id           Int         @id @default(autoincrement())
  /// e.g. `submission.turned_in:<submissionVersionId>`.
  key          String      @unique
  /// assignment.new | assignment.updated | assignment.missing | submission.turned_in |
  /// submission.unsubmitted | submission.returned | comment.new
  type         String
  accountId    Int
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Event details as JSON (e.g. the field diff of `assignment.updated`).
  payload      String
  createdAt    DateTime    @default(now())

  @@index([type, createdAt])
}

/// Run log: one row per account per sync.
model SyncRun {
  id         Int       @id @default(autoincrement())
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  finishedAt DateTime?
  /// running | ok | session_expired | session_missing | error
  status     String
  baseline   Boolean   @default(false)
  /// Counts as JSON (items, details, versions, events, files).
  stats      String    @default("{}")
  error      String?

  @@index([accountId, startedAt])
}
