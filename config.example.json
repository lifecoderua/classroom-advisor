{
  "profileDir": "~/.classroom-advisor/chrome-profile",
  "dataDir": "./.data",
  "watchedAccounts": ["student-one@school.example", "student-two@school.example"],
  "llmProvider": "claude-cli",
  "claudeBin": "claude",
  "geminiModel": "gemini-3.8-flash",
  "llmTimeoutMs": 180000,
  "runIntervalMin": 60,
  "quietHours": "22:00-07:00",
  "alertLookbackDays": 14,
  "backlogForgetDays": 14,
  "fullRefreshDays": 7,
  "syncDelayMs": 300,
  "telegramChatIds": ["123456789"],
  "telegramDigestTime": "19:00"
}
